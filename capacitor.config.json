{
  "appId": "com.altamash.nutriplan",
  "appName": "NutriPlan",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": { "allowMixedContent": false },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "backgroundColor": "#6C5CE7",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  },
  "server": { "androidScheme": "https" }
}
